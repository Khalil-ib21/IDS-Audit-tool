          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="([A-Za-z0-9]+[-_])*WD[-_]?[0-9]+([-_][A-Za-z0-9]+)*"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="IfcZone" ifcVersion="IFC4X3_ADD2" identifier="BDNS-IfcZone-REV" description="An IFCZONE must be named as one of the 1 BDNS code(s) mapped to it (ZONE).">
