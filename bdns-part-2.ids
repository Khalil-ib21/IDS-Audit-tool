<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!--edit with ONESTRUCTION Inc.-->
  <ids:info>
    <ids:title>BDNS two-way validation (IFC4X3_ADD2) - part-2</ids:title>
    <ids:copyright>ONESTRUCTION Inc.</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Generated by ONESTRUCTION Inc. from the buildingSMART UK&amp;I / Open Data Institute BDNS Abbreviations Register (theodi/BDNS @ fb56a0982f4177eceda2fdcf2330d5efbcd4957c), 943 rows, column 'ifc4_3'. Each register row yields a forward specification (asset name -&gt; IFC entity, description and classification) and contributes to a reverse specification grouped by entity and PredefinedType (IFC entity -&gt; permitted asset codes). Declared schema IFC4X3_ADD2; occurrence names match CODE[type]-number per the BDNS_Specification_naming_syntax.md (Device/Asset role name) in tolerant mode (specification plus leading zeros and optional hyphen-delimited prefix and suffix, as found in practice); the abbreviation is also required as an IfcClassificationReference in system 'BDNS' per section 3.9.1; applicability cardinality optional. Entities and PredefinedTypes validated against the declared IFC schema with IfcOpenShell; rows not expressible in that schema are omitted rather than approximated. Contributors: Khalil.ib2111@gmail.com. This file covers part 2: 320 of the register's 943 rows.</ids:description>
    <ids:author>lucas@onestruction.com</ids:author>
    <ids:date>2026-07-29</ids:date>
    <ids:purpose>Two-way validation of BDNS asset codes against IFC entity classification</ids:purpose>
    <ids:milestone>Handover</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="BDNS - VAS" ifcVersion="IFC4X3_ADD2" identifier="BDNS-VAS-FWD" description="An asset named VAS-nnnnn must be IFCAUDIOVISUALAPPLIANCE described as 'emergency voice communication - voice alarm speaker'.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="([A-Za-z0-9]+[-_])*VAS[-_]?[0-9]+([-_][A-Za-z0-9]+)*"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCAUDIOVISUALAPPLIANCE</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>SPEAKER</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>emergency voice communication - voice alarm speaker</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:classification uri="https://theodi.github.io/BDNS/" cardinality="required">
          <ids:value>
            <ids:simpleValue>VAS</ids:simpleValue>
          </ids:value>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:requirements>
    </ids:specification>
