<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!--edit with ONESTRUCTION Inc.-->
  <ids:info>
    <ids:title>MSI exchange - topology (core)</ids:title>
    <ids:copyright>ONESTRUCTION Inc.</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Generated by ONESTRUCTION Inc. from the MSI information exchange requirement table (MSI_Information_Exchange_Comments_AP_response, Sheet 3), cross-read against Sheet 1 for scope and actor. Asset decomposition and connectivity relationships, core profile (Sheet 3 rows 50-56). Separated because this is the only group where the Core, Brick and Haystack profiles diverge: they agree on 49 of Sheet 3's 57 rows and all eight disagreements are relationship or tagging rows. Core Tag is omitted pending a definition, having no description, example or IFC mapping in either sheet. Product Name is omitted: no IFC property exists and Sheet 3 gives the asset register as the source of truth. Fed By and Feeds (Sheet 3 rows 52-53) are not expressible in IDS at all: IfcRelConnectsPorts cannot be traversed, and IfcSystem membership carries no direction. Where this profile requires connectivity, system assignment is checked as the nearest proxy; where it does not, no check is emitted, because partOf accepts only 'required' or 'prohibited' and omitting the attribute means required by schema default. Contributors: Khalil.ib2111@gmail.com.</ids:description>
    <ids:author>lucas@onestruction.com</ids:author>
    <ids:date>2026-07-29</ids:date>
    <ids:purpose>Asset decomposition and connectivity</ids:purpose>
    <ids:milestone>Handover</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="Asset decomposition - is part of" ifcVersion="IFC4X3_ADD2" identifier="MSI-06-ISPARTOF" description="Where parent and child assets are defined, the child is aggregated to its parent (Sheet 3 row 50; core profile).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required" instructions="Aggregate this asset to its parent asset using IfcRelAggregates.">
