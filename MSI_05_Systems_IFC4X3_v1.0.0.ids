<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!--edit with ONESTRUCTION Inc.-->
  <ids:info>
    <ids:title>MSI exchange - systems</ids:title>
    <ids:copyright>ONESTRUCTION Inc.</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Generated by ONESTRUCTION Inc. from the MSI information exchange requirement table (MSI_Information_Exchange_Comments_AP_response, Sheet 3), cross-read against Sheet 1 for scope and actor. IfcSystem and IfcDistributionSystem identity, description and Uniclass Systems classification (Sheet 3 rows 39-43). Contributors: Khalil.ib2111@gmail.com.</ids:description>
    <ids:author>lucas@onestruction.com</ids:author>
    <ids:date>2026-07-29</ids:date>
    <ids:purpose>System identity and classification</ids:purpose>
    <ids:milestone>Handover</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="System identification" ifcVersion="IFC4X3_ADD2" identifier="MSI-05-IFCSYSTEM-NAME" description="Every IFCSYSTEM carries a name (Sheet 3 rows 39-42; mandatory in all three profiles). Sheet 1 notes BDNS system abbreviations are pending release; when published a second classification requirement may be added.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSYSTEM</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="System classification" ifcVersion="IFC4X3_ADD2" identifier="MSI-05-IFCSYSTEM-UNICLASS" description="Every IFCSYSTEM is classified against Uniclass Systems (Sheet 3 row 40; mandatory in all three profiles). Sheet 3 notes 'use controlled vocabulary if possible'; the system is required here but individual codes are not enumerated.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSYSTEM</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:classification cardinality="required">
          <ids:system>
            <ids:simpleValue>Uniclass Ss</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Distribution system identification" ifcVersion="IFC4X3_ADD2" identifier="MSI-05-IFCDISTRIBUTIONSYSTEM-NAME" description="Every IFCDISTRIBUTIONSYSTEM carries a name (Sheet 3 rows 39-42; mandatory in all three profiles). Sheet 1 notes BDNS system abbreviations are pending release; when published a second classification requirement may be added.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCDISTRIBUTIONSYSTEM</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Distribution system classification" ifcVersion="IFC4X3_ADD2" identifier="MSI-05-IFCDISTRIBUTIONSYSTEM-UNICLASS" description="Every IFCDISTRIBUTIONSYSTEM is classified against Uniclass Systems (Sheet 3 row 40; mandatory in all three profiles). Sheet 3 notes 'use controlled vocabulary if possible'; the system is required here but individual codes are not enumerated.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCDISTRIBUTIONSYSTEM</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:classification cardinality="required">
          <ids:system>
            <ids:simpleValue>Uniclass Ss</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
