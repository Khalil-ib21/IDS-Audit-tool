    <ids:specification name="Zone identification" ifcVersion="IFC4X3_ADD2" identifier="MSI-01-IFCSPATIALZONE" description="Where present, a IFCSPATIALZONE carries a user-assigned number and name (Sheet 3 rows 16-19; optional in Core, Brick and Haystack).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Spatial group (non-geometric) identification" ifcVersion="IFC4X3_ADD2" identifier="MSI-01-IFCZONE" description="Where present, a IFCZONE carries a user-assigned number and name (Sheet 3 rows 20-23; optional in Core, Brick and Haystack).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Site contained in Project" ifcVersion="IFC4X3_ADD2" identifier="MSI-01-AGG-IFCSITE" description="Site contained in Project via IfcRelAggregates (Sheet 3 row 44; mandatory in all three profiles).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCPROJECT</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Building contained in Site" ifcVersion="IFC4X3_ADD2" identifier="MSI-01-AGG-IFCBUILDING" description="Building contained in Site via IfcRelAggregates (Sheet 3 row 45-46; mandatory in all three profiles).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCSITE</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Level contained in Building" ifcVersion="IFC4X3_ADD2" identifier="MSI-01-AGG-IFCBUILDINGSTOREY" description="Level contained in Building via IfcRelAggregates (Sheet 3 row 47; mandatory in all three profiles).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCBUILDING</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Room contained in Level" ifcVersion="IFC4X3_ADD2" identifier="MSI-01-AGG-IFCSPACE" description="Room contained in Level via IfcRelAggregates (Sheet 3 row 48; mandatory in all three profiles).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELAGGREGATES" cardinality="required">
          <ids:entity>
            <ids:name>
              <ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue>
            </ids:name>
          </ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Element contained in spatial structure" ifcVersion="IFC4X3_ADD2" identifier="MSI-01-CONTAINED" description="Every BDNS-classified asset is contained in a spatial structure element (Sheet 3 row 49; mandatory in all three profiles). The concrete containers are listed explicitly because IDS entity facets do not inherit and IfcSpatialElement is abstract.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
          <ids:entity>
            <ids:name>
              <xs:restriction base="xs:string">
                <xs:enumeration value="IFCSPACE"/>
                <xs:enumeration value="IFCBUILDINGSTOREY"/>
                <xs:enumeration value="IFCBUILDING"/>
                <xs:enumeration value="IFCSITE"/>
              </xs:restriction>
            </ids:name>
          </ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
