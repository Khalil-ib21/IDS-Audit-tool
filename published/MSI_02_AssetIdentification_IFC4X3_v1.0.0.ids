<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!--edit with ONESTRUCTION Inc.-->
  <ids:info>
    <ids:title>MSI exchange - asset identification</ids:title>
    <ids:copyright>ONESTRUCTION Inc.</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Generated by ONESTRUCTION Inc. from the MSI information exchange requirement table (MSI_Information_Exchange_Comments_AP_response, Sheet 3), cross-read against Sheet 1 for scope and actor. Name, instance number, BDNS classification and type description for BDNS-classified assets (Sheet 3 rows 24-30). Name format is checked separately against the BDNS register. Contributors: Khalil.ib2111@gmail.com.</ids:description>
    <ids:author>lucas@onestruction.com</ids:author>
    <ids:date>2026-07-29</ids:date>
    <ids:purpose>Asset identity and BDNS classification</ids:purpose>
    <ids:milestone>Handover</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="Asset name" ifcVersion="IFC4X3_ADD2" identifier="MSI-02-NAME" description="Every BDNS-classified asset carries a name (Sheet 3 row 25). Format is checked against BDNS_Specification_naming_syntax.md in the BDNS naming IDS, not here: Sheet 3's value rule ^[A-Z]+[0-9]+$ conflicts with Sheet 1 (FCU-00001) and with the BDNS specification (FCU-15), and is invalid as an IDS pattern because xs:pattern is implicitly anchored and treats ^ and $ as literal characters.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Asset instance number" ifcVersion="IFC4X3_ADD2" identifier="MSI-02-TAG" description="Every BDNS-classified asset carries its instance number in Tag (Sheet 3 row 30; mandatory in all three profiles).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Tag</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="BDNS classification" ifcVersion="IFC4X3_ADD2" identifier="MSI-02-BDNS" description="Any asset named in BDNS form carries the abbreviation as the classification identification under system BDNS (Sheet 3 rows 27-28; mandatory in all three profiles). Applicability is by name shape rather than by classification, because applying to BDNS-classified objects and then requiring a BDNS classification would be circular and could never fail. The abbreviation-to-description pairing is checked per code in the BDNS naming IDS.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="[A-Z]{2,6}([1-9][0-9]*)?-[1-9][0-9]*"/>
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:classification uri="https://theodi.github.io/BDNS/" cardinality="required">
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
