    <ids:specification name="Asset connectivity - metered by" ifcVersion="IFC4X3_ADD2" identifier="MSI-06-METEREDBY" description="Sub-meter this asset is metered by (Sheet 3 row 54; core profile). IFC defines no dedicated relationship for this, so Sheet 3's Notes column specifies a custom property set. The property name is used as given; the set is renamed from the Pset_ prefix, which buildingSMART reserves for its own property sets and which ids-tool rejects on a non-standard name.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="optional" instructions="Record the referenced asset name in MSI_Metering.MeterReference.">
          <ids:propertySet>
            <ids:simpleValue>MSI_Metering</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MeterReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Asset connectivity - is controlled by" ifcVersion="IFC4X3_ADD2" identifier="MSI-06-ISCONTROLLEDBY" description="Assets directly controlling this asset (Sheet 3 row 55; core profile). IFC defines no dedicated relationship for this, so Sheet 3's Notes column specifies a custom property set. The property name is used as given; the set is renamed from the Pset_ prefix, which buildingSMART reserves for its own property sets and which ids-tool rejects on a non-standard name. Note: Sheet 3 maps both 'Controls' and 'Is Controlled By' to Pset_Control.ControllerReference, so the two directions cannot be distinguished. One of them needs a different property name before this check is meaningful.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="optional" instructions="Record the referenced asset name in MSI_Control.ControllerReference.">
          <ids:propertySet>
            <ids:simpleValue>MSI_Control</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ControllerReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Asset connectivity - controls" ifcVersion="IFC4X3_ADD2" identifier="MSI-06-CONTROLS" description="Assets directly controlled by this asset (Sheet 3 row 56; core profile). IFC defines no dedicated relationship for this, so Sheet 3's Notes column specifies a custom property set. The property name is used as given; the set is renamed from the Pset_ prefix, which buildingSMART reserves for its own property sets and which ids-tool rejects on a non-standard name. Note: Sheet 3 maps both 'Controls' and 'Is Controlled By' to Pset_Control.ControllerReference, so the two directions cannot be distinguished. One of them needs a different property name before this check is meaningful.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="optional" instructions="Record the referenced asset name in MSI_Control.ControllerReference.">
          <ids:propertySet>
            <ids:simpleValue>MSI_Control</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ControllerReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
