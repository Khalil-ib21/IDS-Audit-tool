<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!--edit with ONESTRUCTION Inc.-->
  <ids:info>
    <ids:title>MSI exchange - topology (haystack)</ids:title>
    <ids:copyright>ONESTRUCTION Inc.</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Generated by ONESTRUCTION Inc. from the MSI information exchange requirement table (MSI_Information_Exchange_Comments_AP_response, Sheet 3), cross-read against Sheet 1 for scope and actor. Asset decomposition and connectivity relationships, haystack profile (Sheet 3 rows 50-56). Separated because this is the only group where the Core, Brick and Haystack profiles diverge: they agree on 49 of Sheet 3's 57 rows and all eight disagreements are relationship or tagging rows. Core Tag is omitted pending a definition, having no description, example or IFC mapping in either sheet. Product Name is omitted: no IFC property exists and Sheet 3 gives the asset register as the source of truth. Fed By and Feeds (Sheet 3 rows 52-53) are not expressible in IDS at all: IfcRelConnectsPorts cannot be traversed, and IfcSystem membership carries no direction. Where this profile requires connectivity, system assignment is checked as the nearest proxy; where it does not, no check is emitted, because partOf accepts only 'required' or 'prohibited' and omitting the attribute means required by schema default. Contributors: Khalil.ib2111@gmail.com.</ids:description>
    <ids:author>lucas@onestruction.com</ids:author>
    <ids:date>2026-07-29</ids:date>
    <ids:purpose>Asset decomposition and connectivity</ids:purpose>
    <ids:milestone>Handover</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="Asset connectivity - metered by" ifcVersion="IFC4X3_ADD2" identifier="MSI-06-METEREDBY" description="Sub-meter this asset is metered by (Sheet 3 row 54; haystack profile). IFC defines no dedicated relationship for this, so Sheet 3's Notes column specifies a custom property set. The property name is used as given; the set is renamed from the Pset_ prefix, which buildingSMART reserves for its own property sets and which ids-tool rejects on a non-standard name.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="optional" instructions="Record the referenced asset name in MSI_Metering.MeterReference.">
          <ids:propertySet>
            <ids:simpleValue>MSI_Metering</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MeterReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Asset connectivity - is controlled by" ifcVersion="IFC4X3_ADD2" identifier="MSI-06-ISCONTROLLEDBY" description="Assets directly controlling this asset (Sheet 3 row 55; haystack profile). IFC defines no dedicated relationship for this, so Sheet 3's Notes column specifies a custom property set. The property name is used as given; the set is renamed from the Pset_ prefix, which buildingSMART reserves for its own property sets and which ids-tool rejects on a non-standard name. Note: Sheet 3 maps both 'Controls' and 'Is Controlled By' to Pset_Control.ControllerReference, so the two directions cannot be distinguished. One of them needs a different property name before this check is meaningful.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="optional" instructions="Record the referenced asset name in MSI_Control.ControllerReference.">
          <ids:propertySet>
            <ids:simpleValue>MSI_Control</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ControllerReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Asset connectivity - controls" ifcVersion="IFC4X3_ADD2" identifier="MSI-06-CONTROLS" description="Assets directly controlled by this asset (Sheet 3 row 56; haystack profile). IFC defines no dedicated relationship for this, so Sheet 3's Notes column specifies a custom property set. The property name is used as given; the set is renamed from the Pset_ prefix, which buildingSMART reserves for its own property sets and which ids-tool rejects on a non-standard name. Note: Sheet 3 maps both 'Controls' and 'Is Controlled By' to Pset_Control.ControllerReference, so the two directions cannot be distinguished. One of them needs a different property name before this check is meaningful.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTEXT" cardinality="optional" instructions="Record the referenced asset name in MSI_Control.ControllerReference.">
          <ids:propertySet>
            <ids:simpleValue>MSI_Control</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ControllerReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
