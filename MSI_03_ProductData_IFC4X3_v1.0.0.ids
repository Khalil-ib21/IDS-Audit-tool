<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!--edit with ONESTRUCTION Inc.-->
  <ids:info>
    <ids:title>MSI exchange - product and manufacture data</ids:title>
    <ids:copyright>ONESTRUCTION Inc.</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Generated by ONESTRUCTION Inc. from the MSI information exchange requirement table (MSI_Information_Exchange_Comments_AP_response, Sheet 3), cross-read against Sheet 1 for scope and actor. Manufacturer, model, serial number, installation date and asset identifier (Sheet 3 rows 31 and 35-38). Separated because the actor is the contractor rather than the designer, and Sheet 1 gives the asset register as the source of truth for most of it. Contributors: Khalil.ib2111@gmail.com.</ids:description>
    <ids:author>lucas@onestruction.com</ids:author>
    <ids:date>2026-07-29</ids:date>
    <ids:purpose>Manufacturer and product data</ids:purpose>
    <ids:milestone>Handover</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="Manufacturer" ifcVersion="IFC4X3_ADD2" identifier="MSI-03-MANUFACTURER" description="Every BDNS-classified asset records its manufacturer (Sheet 3 row 35; mandatory in all three profiles). Sheet 1 notes the value may be derived from the MAC address at commissioning.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Manufacturer</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Model reference" ifcVersion="IFC4X3_ADD2" identifier="MSI-03-MODEL" description="Model reference where recorded in the model (Sheet 3 row 37; optional in all three profiles). Sheet 1 gives the asset register as the source of truth.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ModelLabel</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Serial number" ifcVersion="IFC4X3_ADD2" identifier="MSI-03-SERIAL" description="Serial number where recorded in the model (Sheet 1; the asset register is the source of truth).">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCIDENTIFIER" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConstructionOccurence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SerialNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Installation date" ifcVersion="IFC4X3_ADD2" identifier="MSI-03-INSTALLDATE" description="Installation date where recorded, ISO 8601 (Sheet 1). Sheet 1's AP response suggests this may also serve as the commissioning date.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCDATE" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConstructionOccurence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InstallationDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Panel reference" ifcVersion="IFC4X3_ADD2" identifier="MSI-03-PANELREF" description="The panel reference the asset is linked to (Sheet 1; optional). Sheet 3 notes PanelReference is not an IFC standard property and specifies Pset_Electrical as option 1; option 2 manages it in the asset register instead.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_Electrical</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PanelReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Equipment asset identifier" ifcVersion="IFC4X3_ADD2" identifier="MSI-03-ASSETID" description="Concatenated project asset identifier where used (Sheet 3 row 31; optional). The concatenation is defined in the BEP and must match the asset register.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCIDENTIFIER" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConstructionOccurence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AssetIdentifier</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
