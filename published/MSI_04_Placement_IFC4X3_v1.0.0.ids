<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!--edit with ONESTRUCTION Inc.-->
  <ids:info>
    <ids:title>MSI exchange - placement</ids:title>
    <ids:copyright>ONESTRUCTION Inc.</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Generated by ONESTRUCTION Inc. from the MSI information exchange requirement table (MSI_Information_Exchange_Comments_AP_response, Sheet 3), cross-read against Sheet 1 for scope and actor. Object placement presence for BDNS-classified assets (Sheet 3 rows 32-34). Coordinate values are out of scope for IDS. Contributors: Khalil.ib2111@gmail.com.</ids:description>
    <ids:author>lucas@onestruction.com</ids:author>
    <ids:date>2026-07-29</ids:date>
    <ids:purpose>Asset placement</ids:purpose>
    <ids:milestone>Handover</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="Asset placement" ifcVersion="IFC4X3_ADD2" identifier="MSI-04-PLACEMENT" description="Every BDNS-classified asset carries an object placement (Sheet 3 rows 32-34). Coordinate values are not checked: Sheet 3 specifies local relative placement while Sheet 1 specifies absolute OS Grid coordinates, and IDS cannot inspect a nested attribute chain such as ObjectPlacement.RelativePlacement.Location.Coordinates in any case. The coordinate reference system is a BEP matter.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:classification>
          <ids:system>
            <ids:simpleValue>BDNS</ids:simpleValue>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Give this asset an object placement. The coordinate reference system is defined in the BEP.">
          <ids:name>
            <ids:simpleValue>ObjectPlacement</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
